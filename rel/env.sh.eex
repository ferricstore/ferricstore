#!/bin/sh

# A Mix release starts Erlang distribution before runtime.exs and the
# application run. Mirror FerricStore's public cluster variables into the
# release variables early enough for the running BEAM identity and cookie to
# match the values used by discovery.
if [ -n "${FERRICSTORE_NODE_NAME:-}" ]; then
  if [ -n "${RELEASE_NODE:-}" ] && [ "$RELEASE_NODE" != "$FERRICSTORE_NODE_NAME" ]; then
    echo "RELEASE_NODE must match FERRICSTORE_NODE_NAME" >&2
    exit 1
  fi

  RELEASE_NODE="$FERRICSTORE_NODE_NAME"

  # Fargate/Cloud Map identities are fully-qualified DNS names and require
  # long-name distribution. Local Docker and Compose clusters commonly use a
  # single-label service hostname, which Erlang accepts only in short-name
  # mode. Infer the correct mode from the configured host so both deployments
  # retain their stable, explicit node identity.
  ferricstore_node_host="${FERRICSTORE_NODE_NAME#*@}"

  case "$ferricstore_node_host" in
    *.*) ferricstore_distribution="name" ;;
    *) ferricstore_distribution="sname" ;;
  esac

  if [ -n "${RELEASE_DISTRIBUTION:-}" ] && [ "$RELEASE_DISTRIBUTION" != "$ferricstore_distribution" ]; then
    echo "RELEASE_DISTRIBUTION must be $ferricstore_distribution for FERRICSTORE_NODE_NAME=$FERRICSTORE_NODE_NAME" >&2
    exit 1
  fi

  RELEASE_DISTRIBUTION="$ferricstore_distribution"
  export RELEASE_NODE RELEASE_DISTRIBUTION
fi

if [ -n "${FERRICSTORE_COOKIE:-}" ]; then
  if [ -n "${RELEASE_COOKIE:-}" ] && [ "$RELEASE_COOKIE" != "$FERRICSTORE_COOKIE" ]; then
    echo "RELEASE_COOKIE must match FERRICSTORE_COOKIE" >&2
    exit 1
  fi

  RELEASE_COOKIE="$FERRICSTORE_COOKIE"
  export RELEASE_COOKIE
fi
