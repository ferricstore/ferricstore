<% data = assigns.data %>
<%= page_head("Security - FerricStore", nil) %>
<body>
<div class="layout">
<%= render_sidebar_static("security") %>
<main class="main-content" id="dashboard-main" tabindex="-1">
<%= render_page_header("security", intro: "Manage OSS identities and verify the effective command, key, channel, and dashboard-route access granted to each account.") %>
<div class="content">
<%= render_acl_security(data) %>
</div>
</main>
</div>
</body>
</html>
