<% data = assigns.data %>
<% counts = Map.get(data, :counts, %{}) %>
<% approvals = Map.get(data, :approvals, []) %>
<% circuits = Map.get(data, :circuits, []) %>
<% budgets = Map.get(data, :budgets, []) %>
<% limits = Map.get(data, :limits, []) %>
<%= page_head("FerricFlow Governance - FerricStore", nil) %>
<body>
  <div class="layout">
    <%= render_sidebar_static("flow_governance") %>
    <main class="main-content" id="dashboard-main" tabindex="-1">
      <%= render_page_header("flow_governance", intro: "Inspect approval requests, durable budget counters, and distributed credit-limit leases used by governed workflows.") %>
      <div class="content">
                <%= if Map.get(data, :governance_form_only?, false) do %>
        <%= render_flow_governance_form_recovery(data) %>
        <% else %>
        <%= render_flow_context_tools(data, "flow_governance") %>
        <%= render_flow_governance_summary(data) %>
        <%= render_flow_governance_filters(data) %>
        <%= render_dashboard_disclosure("Approvals", length(approvals), render_flow_governance_approvals(approvals, Map.get(data, :filters, %{})), open: Map.get(counts, :pending_approvals, 0) > 0) %>
        <%= render_dashboard_disclosure("Circuits", length(circuits), render_flow_governance_circuit_actions(Map.get(data, :filters, %{})) <> render_flow_governance_circuit_graph(circuits) <> render_flow_governance_circuits(circuits, Map.get(data, :filters, %{})) <> render_flow_governance_circuit_timeline(circuits), open: Map.get(counts, :open_circuits, 0) + Map.get(counts, :half_open_circuits, 0) > 0 or is_map(get_in(data, [:filters, :circuit_review]))) %>
        <%= render_dashboard_disclosure("Budgets and limits", length(budgets) + length(limits), render_flow_governance_budgets(budgets) <> render_flow_governance_limits(limits), open: budgets != [] or limits != []) %>
        <%= render_dashboard_disclosure("State metadata", "query", render_flow_governance_state_meta_filters(data) <> render_flow_governance_state_meta(data), open: state_meta_open?(data)) %>
        <% end %>
      </div>
    </main>
  </div>
</body>
</html>
