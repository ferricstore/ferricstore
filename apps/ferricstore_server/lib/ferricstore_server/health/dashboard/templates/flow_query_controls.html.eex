<% data = assigns.data %>
<% filters = data.filters %>
<% discovery = Map.get(data, :discovery, %{}) %>
<% workbench = Map.get(data, :workbench, FerricstoreServer.Health.Dashboard.Flow.QueryWorkbench.default_form()) %>
<% guided_active = workbench.mode != :advanced %>
<% advanced_open = filters.kind == "search" or Enum.any?([:attribute_key, :state_meta_key, :state_meta_state, :from_ms, :to_ms], &(Map.get(filters, &1) not in [nil, ""])) or Map.get(filters, :rev, false) or map_size(Map.get(filters, :errors, %{})) > 0 %>
<section class="flow-query-console" data-flow-query-workbench data-flow-query-draft-scope="<%= escape_attr(Map.get(data, :draft_scope) || "") %>" aria-label="Query editor">
  <div class="flow-query-toolbar">
    <div class="flow-query-mode-tabs" role="tablist" aria-label="Query mode">
      <button type="button" role="tab" id="flow-query-tab-guided" aria-controls="flow-query-panel-guided" aria-selected="<%= if guided_active, do: "true", else: "false" %>" tabindex="<%= if guided_active, do: "0", else: "-1" %>" data-flow-query-mode-tab="guided">Guided draft</button>
      <button type="button" role="tab" id="flow-query-tab-advanced" aria-controls="flow-query-panel-advanced" aria-selected="<%= if guided_active, do: "false", else: "true" %>" tabindex="<%= if guided_active, do: "-1", else: "0" %>" data-flow-query-mode-tab="advanced">Raw FQL draft</button>
    </div>
    <span class="flow-query-payload-note">Payloads unloaded by default</span>
  </div>
  <p class="flow-section-note">Independent drafts. Switching drafts does not transfer changes or replace the displayed results.</p>
  <div id="flow-query-panel-guided" role="tabpanel" aria-labelledby="flow-query-tab-guided"<%= if guided_active, do: "", else: " hidden" %> data-flow-query-mode="guided">
    <%= render_flow_query_kind_help(filters.kind) %>
    <form class="flow-filter-form flow-query-form" action="/dashboard/flow/query" method="get" data-flow-query-form>
      <div class="flow-query-fields flow-query-primary-fields">
        <label class="flow-query-field">
          <span>Query operation</span>
          <select class="flow-search-input" name="kind" title="Flow query to run" data-flow-query-kind>
            <%= render_flow_query_kind_options(filters.kind) %>
          </select>
        </label>
        <%= render_flow_query_type_field(filters, discovery) %>
        <%= render_flow_query_partition_field(filters) %>
        <%= render_flow_query_state_field(filters) %>
        <%= render_flow_query_run_state_field(filters) %>
        <%= render_flow_query_id_field(filters) %>
        <%= render_flow_query_limit_field(filters) %>
      </div>
      <details class="flow-query-advanced"<%= if advanced_open, do: " open", else: "" %>>
        <summary>Predicates and time bounds</summary>
        <div class="flow-query-advanced-body">
          <p class="flow-field-help" data-flow-query-search-requirement<%= if filters.kind == "search", do: "", else: " hidden" %>>Search requires an indexed attribute or state metadata predicate.</p>
          <div class="flow-query-fields">
            <%= render_flow_query_time_fields(filters) %>
            <%= render_flow_query_direction_field(filters) %>
          </div>
          <fieldset class="flow-query-predicate-group" data-flow-query-kinds="list search stats"<%= flow_query_hidden_attr(filters, ~w(list search stats)) %>>
            <legend>Indexed attribute predicate</legend>
            <%= render_flow_query_attribute_fields(filters) %>
          </fieldset>
          <fieldset class="flow-query-predicate-group" data-flow-query-kinds="search"<%= flow_query_hidden_attr(filters, ~w(search)) %>>
            <legend>State metadata predicate</legend>
            <%= render_flow_query_state_meta_fields(filters) %>
          </fieldset>
        </div>
      </details>
      <div class="flow-query-actions">
        <button class="flow-search-button flow-query-run" type="submit" data-flow-query-run-action>Run</button>
        <button class="flow-search-button secondary" type="submit" name="inspect" value="true" formnovalidate data-flow-query-options-action data-flow-query-kinds="list search stats terminals failures stuck"<%= flow_query_hidden_attr(filters, ~w(list search stats terminals failures stuck)) %>>Show options</button>
      </div>
      <%= render_flow_query_discovery(discovery) %>
      <%= render_flow_query_discovery_datalists(discovery) %>
    </form>
    <%= render_flow_query_dynamic_script() %>
  </div>
  <div id="flow-query-panel-advanced" role="tabpanel" aria-labelledby="flow-query-tab-advanced"<%= if guided_active, do: " hidden", else: "" %> data-flow-query-mode="advanced">
    <%= FerricstoreServer.Health.Dashboard.Render.FlowQueryHelp.render_reference() %>
    <%= FerricstoreServer.Health.Dashboard.Render.FlowQueryControls.render_flow_query_import(Map.get(data, :guided_import), filters.kind) %>
    <form class="flow-query-workbench-form" action="/dashboard/flow/query" method="post" data-flow-query-workbench-form>
      <label>
        FQL1
        <textarea class="flow-query-editor mono" name="fql" rows="6" spellcheck="false"<%= FerricstoreServer.Health.Dashboard.Render.FlowQueryControls.workbench_error_attrs(workbench, :fql) %> placeholder="FROM runs WHERE type = @type ORDER BY updated_at_ms DESC LIMIT 50"><%= escape(workbench.fql) %></textarea>
        <%= FerricstoreServer.Health.Dashboard.Render.FlowQueryControls.render_workbench_error(workbench, :fql) %>
      </label>
      <label>
        Parameters (JSON)
        <textarea class="flow-query-params mono" name="params_json" rows="3" spellcheck="false"<%= FerricstoreServer.Health.Dashboard.Render.FlowQueryControls.workbench_error_attrs(workbench, :params_json) %> placeholder='{"type": "order_fulfillment"}'><%= escape(workbench.params_json) %></textarea>
        <%= FerricstoreServer.Health.Dashboard.Render.FlowQueryControls.render_workbench_error(workbench, :params_json) %>
      </label>
      <div class="flow-query-actions">
        <button class="flow-search-button flow-query-run" type="submit" name="action" value="run">Run FQL</button>
        <button class="flow-search-button secondary" type="submit" name="action" value="explain">Explain</button>
        <button class="flow-search-button secondary" type="submit" name="action" value="analyze">Analyze</button>
        <button class="flow-search-button secondary" type="button" data-flow-query-copy-field="fql">Copy FQL</button>
        <button class="flow-search-button secondary" type="button" data-flow-query-copy-field="params_json">Copy params</button>
        <span class="flow-query-copy-status" data-flow-query-copy-status aria-live="polite"></span>
      </div>
    </form>
  </div>
  <%= render_flow_query_mode_script(workbench.mode) %>
</section>
