<% data = assigns.data %>
<% summary = Map.get(data, :summary, %{}) %>
<dl class="flow-failure-summary-ribbon" aria-label="Failure summary">
  <div>
    <dt>Failure candidates</dt>
    <dd><%= format_number(Map.get(summary, :total, 0)) %></dd>
    <span>sampled and projected</span>
  </div>
  <div>
    <dt>Failed</dt>
    <dd class="c-red"><%= format_number(Map.get(summary, :failed, 0)) %></dd>
    <span>terminal records</span>
  </div>
  <div>
    <dt>Expired leases</dt>
    <dd class="c-yellow"><%= format_number(Map.get(summary, :expired_leases, 0)) %></dd>
    <span>fenced reclaim candidates</span>
  </div>
  <div>
    <dt>Maxed retries</dt>
    <dd><%= format_number(Map.get(summary, :maxed, 0)) %></dd>
    <span>attempt limit reached</span>
  </div>
</dl>
