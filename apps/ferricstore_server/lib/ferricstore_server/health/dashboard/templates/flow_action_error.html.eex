<% data = assigns.data %>
<%= page_head("Workflow Action - FerricStore", nil) %>
<body>
<div class="layout">
<%= render_sidebar_static("flow_detail") %>
<main class="main-content" id="dashboard-main" tabindex="-1">
<%= render_subpage_header("Workflow Action") %>
<div class="content">
  <div class="flow-alert flow-alert-error" role="alert" id="flow-action-error"><%= escape(data.error) %></div>
  <p class="page-intro">Draft retained for <strong class="mono"><%= escape(data.id) %></strong>. <a href="<%= escape_attr(data.review_url) %>">Review workflow</a></p>
  <%= if data.action == :rewind, do: render_flow_rewind_action(data), else: render_flow_signal_action(data) %>
</div>
</main>
</div>
</body>
</html>
