<% data = assigns.data %>
<%= page_head("FerricFlow Policies - FerricStore", nil) %>
<body>
<div class="layout">
<%= render_sidebar_static("flow_policies") %>
<main class="main-content" id="dashboard-main" tabindex="-1">
<%= render_subpage_header("FerricFlow Policies") %>
<div class="content">
<%= render_page_intro("FerricFlow Policies", "Review and edit retry, exhausted-state, and retention policy defaults for Flow types and states.") %>
<%= render_flow_context_tools(data, "flow_policies") %>
<%= render_flow_policy_editor(data) %>
<%= if Map.get(data, :catalog_loaded, true) do %>
<%= render_flow_policies_table(data.policies, Map.get(data, :policy_scan, %{})) %>
<%= FerricstoreServer.Health.Dashboard.Render.FlowIndexCatalog.render(Map.get(data, :index_catalog)) %>
<% end %>
<details class="dashboard-disclosure"><summary>Policy command reference</summary><%= render_flow_policy_commands() %></details>
</div>
</main>
</div>
</body>
</html>
