<% data = assigns.data %>
<%= page_head("Flow Workers - FerricStore", 2, chartjs: true) %>
<body data-dashboard-live-page="flow-workers" data-dashboard-live-url="<%= escape(FerricstoreServer.Health.Dashboard.Flow.Browse.scope_live_url("workers", data)) %>" data-dashboard-live-interval-ms="2000">
<div class="layout">
<%= render_sidebar_static("flow_workers") %>
<main class="main-content" id="dashboard-main" tabindex="-1">
<%= render_subpage_header("Flow Workers") %>
<div class="content">
<%= render_page_intro("Flow Workers", "Track worker leases, running jobs, lease age, and stalled worker pressure.") %>
<%= render_flow_context_tools(data, "flow_workers") %>
<%= render_live_component("flow_workers", render_flow_workers(data.workers, Map.get(data, :filters, %{}))) %>
<%= render_live_component("flow_running_records", render_flow_running_records(data.running_records, data.total_sampled, data.sample_limit)) %>
<details class="dashboard-disclosure" id="flow-worker-breakdown">
<summary>Lease distribution and FIFO lanes</summary>
<%= render_live_component("flow_workers_chart", render_flow_workers_chart(data.workers)) %>
<%= render_live_component("flow_fifo_lanes", render_flow_fifo_lanes(Map.get(data, :fifo_lanes, []), data.total_sampled, data.sample_limit, Map.get(data, :fifo_coverage, %{}))) %>
</details>
</div>
</main>
</div>
</body>
</html>
