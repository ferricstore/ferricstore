<% data = assigns.data %>
<% result = data.result %>
<div class="section-title">Result <span class="badge badge-idle"><%= escape(flow_query_result_command(result)) %></span>
<%= if Map.get(result, :status) == :ok do %>
<span class="flow-query-result-count"><%= escape(Map.get(result, :message, "")) %></span>
<% end %>
</div>
<%= if Map.get(result, :status) != :ok, do: render_flow_query_status(result) %>
<%= render_flow_query_provenance(data) %>
<%= render_flow_query_table(result) %>
<%= render_flow_query_continuation(result) %>
<%= render_flow_query_metadata(result) %>
<%= render_flow_query_visualization(result) %>
