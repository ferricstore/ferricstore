<% data = assigns.data %>
<% {expired_leases, failure_records} = flow_failure_groups(data) %>
<section class="flow-failure-recovery-section" id="flow-failures-expired" aria-labelledby="flow-failures-expired-title">
<h2 class="section-title" id="flow-failures-expired-title">Expired leases <span class="badge badge-warning"><%= length(expired_leases) %></span> <span class="badge badge-idle"><%= sampled_scan_label(data.total_sampled, data.sample_limit) %></span></h2>
<p class="flow-section-note">Their workers stopped renewing the lease. Open a group to see its runs and reclaim them.</p>
<%= render_expired_lease_groups(expired_leases, data) %>
<%= render_flow_recovery_actions(data) %>
</section>

<section id="flow-failures-terminal" aria-labelledby="flow-failures-terminal-title">
<h2 class="section-title" id="flow-failures-terminal-title">Failed and out of retries <span class="badge badge-idle"><%= length(failure_records) %></span></h2>
<%= render_terminal_failure_rows(failure_records) %>
<div class="flow-section-note">Open a run to inspect its history; a failed run can be rewound from its page.</div>
</section>
