<% data = assigns.data %>
<% filters = flow_failures_page_filters(data) %>
<% groups = Recovery.reclaim_groups(data) %>
<%= if groups != [] do %>
<div class="table-scroll" role="region" aria-label="Reclaim candidate groups" tabindex="0"><table>
  <thead><tr><th>Type</th><th>Partition</th><th>Evidence</th><th>Action</th></tr></thead>
  <tbody>
  <%= for group <- groups do %>
    <tr>
      <td class="mono"><%= escape(group.type) %></td>
      <td class="mono"><%= escape(group.partition_key || "No literal partition in evidence") %></td>
      <td><%= group.count %> expired <%= if group.count == 1, do: "lease", else: "leases" %> shown</td>
      <td><%= if group.can_prepare? do %><a class="flow-link" href="<%= escape_attr(Recovery.prepare_reclaim_path(group, filters)) %>">Prepare reclaim</a><% else %><span class="c-muted"><%= if group.partition_key, do: "Reclaim not authorized", else: "Exact partition required" %></span><% end %></td>
    </tr>
  <% end %>
  </tbody>
</table></div>
<% end %>
<div class="flow-policy-panel">
  <h2 class="section-title">Recovery Actions <%= info_icon("Reclaim only takes expired running leases through FLOW.RECLAIM. Failed terminal flows are listed for triage; rewind stays on the Flow detail page.") %></h2>
  <form id="flow-reclaim-form" class="flow-policy-form" action="/dashboard/flow/failures" method="post" data-dashboard-single-submit aria-describedby="flow-reclaim-scope-note">
    <input type="hidden" name="action" value="reclaim">
    <input type="hidden" name="return_q" value="<%= escape_attr(filters.q || "") %>">
    <input type="hidden" name="return_limit" value="<%= filters.limit %>">
    <input type="hidden" name="return_exact" value="<%= if filters.scan_exact, do: "true", else: "false" %>">
    <div class="flow-policy-grid">
      <label class="flow-policy-field">
        <span>Type</span>
        <input class="flow-search-input mono" name="type" value="<%= escape_attr(filters.type || "") %>" placeholder="required" title="Workflow type to reclaim expired running leases from" required>
      </label>
      <label class="flow-policy-field">
        <span>Partition</span>
        <input class="flow-search-input mono" name="partition_key" value="<%= escape_attr(filters.partition_key || "") %>" placeholder="optional" title="Optional partition scope">
      </label>
      <label class="flow-policy-field">
        <span>Worker</span>
        <input class="flow-search-input mono" name="worker" value="dashboard-recovery" title="Lease owner for reclaimed work">
      </label>
      <label class="flow-policy-field">
        <span>Limit</span>
        <input class="flow-search-input mono" type="number" min="1" max="200" name="limit" value="25" title="Maximum expired leases to reclaim">
      </label>
      <label class="flow-policy-field">
        <span>Lease ms</span>
        <input class="flow-search-input mono" type="number" min="1" name="lease_ms" value="30000" title="New lease duration for reclaimed work">
      </label>
    </div>
    <div class="flow-policy-actions">
      <label class="flow-check-label" title="Required before the dashboard sends FLOW.RECLAIM.">
        <input type="checkbox" name="confirm_reclaim" value="true" required>
        I reviewed the expired leases and understand this changes lease ownership.
      </label>
      <button class="flow-search-button flow-danger-button" type="submit">Reclaim expired leases</button>
    </div>
    <div id="flow-reclaim-scope-note" class="flow-filter-note<%= if filters.q, do: " c-yellow", else: "" %>">
      <%= if filters.q do %>Search text narrows this evidence only. <% end %>Reclaim uses the exact Type and Partition above, up to Limit, and may include leases outside the shown evidence. A blank Partition uses automatic partitions. Terminal failed flows can be rewound from the Flow detail page. Requires +FLOW.RECLAIM.
    </div>
  </form>
</div>
