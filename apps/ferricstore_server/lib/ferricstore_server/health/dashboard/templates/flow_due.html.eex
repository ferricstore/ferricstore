<% data = assigns.data %>
<%= page_head("Flow Due - FerricStore", 2, chartjs: true) %>
<body data-dashboard-live-page="flow-due" data-dashboard-live-url="<%= escape(FerricstoreServer.Health.Dashboard.Flow.Browse.scope_live_url("due", data)) %>" data-dashboard-live-interval-ms="2000">
<div class="layout">
<%= render_sidebar_static("flow_due") %>
<main class="main-content" id="dashboard-main" tabindex="-1">
<%= render_subpage_header("Due / Scheduled") %>
<div class="content">
<%= render_page_intro("Due / Scheduled", "Inspect sampled work whose scheduled time has passed or is still in the future.") %>
<%= render_flow_context_tools(data, "flow_due") %>
<%= render_live_component("flow_due_chart", render_flow_due_chart(data.due_now, data.scheduled)) %>
<%= render_live_component("flow_fifo_lanes", render_flow_fifo_lanes(Map.get(data, :fifo_lanes, []), data.total_sampled, data.sample_limit, Map.get(data, :fifo_coverage, %{}))) %>
<%= render_live_component("flow_due_now", render_flow_due_records("Due Now", data.due_now, data.total_sampled, data.sample_limit)) %>
<%= render_live_component("flow_scheduled", render_flow_due_records("Scheduled Future", data.scheduled, data.total_sampled, data.sample_limit)) %>
</div>
</main>
</div>
</body>
</html>
