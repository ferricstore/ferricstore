<% summary = assigns.data.summary %>
<dl class="flow-overview-ribbon" aria-label="Loaded lineage summary">
  <div><dt>Visible records</dt><dd><%= format_number(summary.total) %></dd><span>current page only</span></div>
  <div><dt>Active</dt><dd><%= format_number(summary.active) %></dd><span>non-terminal records</span></div>
  <div><dt>Terminal</dt><dd><%= format_number(summary.terminal) %></dd><span>completed, failed, cancelled</span></div>
  <div><dt>Failed</dt><dd><%= format_number(summary.failed) %></dd><span>current page only</span></div>
</dl>
