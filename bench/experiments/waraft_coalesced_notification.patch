 %% A feature-flagged single-member fast path writes the local durable log on a
 %% background process. Completion is the only point where log_view advances and
@@ -3210,4 +3223,5 @@
 enter_state(State, Data0) ->
+    ClearedData = cancel_commit_notification(Data0),
     Now = erlang:monotonic_time(millisecond),
-    Data1 = Data0#raft_state{state_start_ts = Now},
+    Data1 = ClearedData#raft_state{state_start_ts = Now},
     Data2 = set_leader_upon_entry(State, Data1),
@@ -4465,3 +4479,23 @@
 -spec maybe_heartbeat(#raft_state{}) -> #raft_state{}.
+-spec maybe_schedule_commit_notification(wa_raft_log:log_index(), #raft_state{}) -> #raft_state{}.
+maybe_schedule_commit_notification(Previous,
+    #raft_state{application = App, table = Table, current_term = Term,
+        commit_index = Commit, handover = undefined, commit_notification = undefined} = Data)
+    when Commit > Previous ->
+    Tag = make_ref(),
+    Delay = max(1, ?RAFT_COMMIT_BATCH_INTERVAL(App, Table)),
+    Timer = erlang:send_after(Delay, self(), {broadcast_commit, Term, Tag}),
+    Data#raft_state{commit_notification = {Timer, Tag, Term}};
+maybe_schedule_commit_notification(_Previous, Data) ->
+    Data.
+
+-spec cancel_commit_notification(#raft_state{}) -> #raft_state{}.
+cancel_commit_notification(#raft_state{commit_notification = undefined} = Data) ->
+    Data;
+cancel_commit_notification(#raft_state{commit_notification = {Timer, Tag, Term}} = Data) ->
+    _ = erlang:cancel_timer(Timer),
+    receive {broadcast_commit, Term, Tag} -> ok after 0 -> ok end,
+    Data#raft_state{commit_notification = undefined}.
+
 -spec leader_timeout(#raft_state{}) -> gen_statem:action().
 -ifdef(TEST).
