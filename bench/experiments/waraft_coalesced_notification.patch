@@ -1668,3 +1669,14 @@
 %% [Async Log Append]
+leader(info, {broadcast_commit, Term, Tag},
+    #raft_state{current_term = Term, commit_notification = {_Timer, Tag, Term}} = Data0) ->
+    Data1 = Data0#raft_state{commit_notification = undefined},
+    Data2 = case Data1#raft_state.handover of
+        undefined -> lists:foldl(fun heartbeat/2, Data1, config_participant_identities(config(Data1)));
+        _ActiveHandover -> Data1
+    end,
+    {keep_state, Data2, ?HEARTBEAT_TIMEOUT(Data2)};
+leader(info, {broadcast_commit, _Term, _Tag}, #raft_state{}) ->
+    keep_state_and_data;
