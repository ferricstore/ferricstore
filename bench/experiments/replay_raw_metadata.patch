@@ -296,6 +296,32 @@ defmodule Ferricstore.Flow.LMDB do
     end
   end

+  @doc false
+  def recovery_flush_in_progress?(path) when is_binary(path) do
+    # Recovery shards must not serialize their repeated metadata probes through
+    # the shared file server. Keep the same no-follow checks on the local files
+    # used by the native LMDB environment, without caching their existence.
+    present? =
+      recovery_path_type?(path, :directory) and
+        (recovery_path_type?(Path.join(path, "data.mdb"), :regular) or
+           recovery_path_type?(Path.join(path, "lock.mdb"), :regular))
+
+    if present? do
+      path
+      |> get(flush_in_progress_key())
+      |> normalize_flush_marker_read()
+    else
+      false
+    end
+  end
+
+  defp recovery_path_type?(path, type) do
+    case :file.read_link_info(path, [:raw, {:time, :posix}]) do
+      {:ok, info} -> File.Stat.from_record(info).type == type
+      _missing_or_unsafe -> false
+    end
+  end
+
   @doc false
   def __normalize_flush_marker_read_for_test__(result), do: normalize_flush_marker_read(result)

