diff --git a/apps/ferricstore/test/ferricstore/flow/lmdb_test.exs b/apps/ferricstore/test/ferricstore/flow/lmdb_test.exs
--- a/apps/ferricstore/test/ferricstore/flow/lmdb_test.exs
+++ b/apps/ferricstore/test/ferricstore/flow/lmdb_test.exs
@@ -351,6 +351,39 @@ defmodule Ferricstore.Flow.LMDBUnitTest do
     refute LMDB.env_present?(file_link_env)
   end

+  test "recovery flush probes preserve markers and recheck replaced or unsafe paths" do
+    root =
+      Path.join(System.tmp_dir!(), "lmdb-recovery-probe-#{System.unique_integer([:positive])}")
+
+    path = Path.join(root, "environment")
+    moved = Path.join(root, "moved")
+    linked = Path.join(root, "linked")
+
+    on_exit(fn ->
+      LMDB.release(path)
+      File.rm_rf!(root)
+    end)
+
+    refute LMDB.recovery_flush_in_progress?(path)
+    refute File.exists?(path)
+    assert :ok = LMDB.write_batch(path, [LMDB.flush_in_progress_put_op()])
+    assert LMDB.recovery_flush_in_progress?(path)
+    assert :ok = LMDB.write_batch(path, [LMDB.flush_in_progress_delete_op()])
+    refute LMDB.recovery_flush_in_progress?(path)
+    assert :ok = LMDB.write_batch(path, [LMDB.flush_in_progress_put_op()])
+    assert LMDB.recovery_flush_in_progress?(path)
+
+    File.ln_s!(path, linked)
+    refute LMDB.recovery_flush_in_progress?(linked)
+    assert :ok = LMDB.release(path)
+    File.rename!(path, moved)
+    File.mkdir_p!(path)
+    refute LMDB.recovery_flush_in_progress?(path)
+    File.ln_s!(Path.join(moved, "data.mdb"), Path.join(path, "data.mdb"))
+    refute LMDB.recovery_flush_in_progress?(path)
+    refute File.exists?(Path.join(path, "lock.mdb"))
+  end
+
   test "history index delete planning preserves metadata read and decode failures" do
     history_key = LMDB.history_index_key("history-owner", "event-1", 10)

