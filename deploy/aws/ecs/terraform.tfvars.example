# Copy this file to terraform.tfvars and pin the image and AMI you intend to operate.
aws_region      = "us-east-1"
name_prefix     = "ferricstore"
container_image = "quay.io/ferricstore/ferricstore:0.11.14"

# The endpoint is always internal and defaults to the stack VPC CIDR.
# Narrow this list when only particular application subnets need access.
# allowed_client_cidr_blocks = ["10.42.128.0/20"]

# FerricStore 0.11.11+ includes the opt-in authenticated HTTP command API.
http_enabled       = false
http_listener_port = 8080

# For HTTPS, use a certificate whose SAN covers http_hostname and configure
# that DNS name as an alias to the internal NLB outside this stack.
# http_listener_port       = 443
# http_hostname            = "ferricstore.internal.example.com"
# http_tls_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/REPLACE_ME"

cpu                      = 2048
memory                   = 4096
cpu_architecture         = "X86_64"
ec2_instance_type        = "m7i.large"
ec2_root_volume_gib      = 80
ec2_max_size             = 2
shard_count              = 0
log_retention_days       = 30

tags = {
  Environment       = "development"
  DeploymentProfile = "oss-single-task-ec2-ephemeral"
}
